# Copy to .env and fill in ONE provider (Groq recommended — free, fast, no GPU needed)

# --- LLM provider: groq | gemini | huggingface | ollama ---
LLM_PROVIDER=groq

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# HuggingFace Inference (free tier, rate-limited): https://huggingface.co/settings/tokens
HF_API_KEY=your_hf_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Ollama (local only — requires GPU for 8B+ models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
